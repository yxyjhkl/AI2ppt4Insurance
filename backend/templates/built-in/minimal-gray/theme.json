{
  "name": "Minimal Gray",
  "category": "Report",
  "description": "Subtle gray palette focused on content clarity.",
  "colors": {
    "primary": "#374151",
    "secondary": "#6b7280",
    "accent": "#3b82f6",
    "background": "#f9fafb",
    "text": "#111827",
    "light-bg": "#f3f4f6",
    "stripe": "#e5e7eb"
  },
  "fonts": {
    "title": "Helvetica",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 30,
    "body-size": 18,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 36,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": false,
    "section_divider": true,
    "page_number": true,
    "header_enabled": true,
    "icon_set": "business"
  },
  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#374151",
      "#6b7280",
      "#3b82f6",
      "#55657e"
    ],
    "progress_bar": true,
    "kpi_card_style": "rounded"
  }
}