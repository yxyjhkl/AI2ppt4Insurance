{
  "name": "Dark Modern",
  "category": "Tech",
  "description": "Dark background with vibrant accents for tech presentations.",
  "colors": {
    "primary": "#111827",
    "secondary": "#3b82f6",
    "accent": "#10b981",
    "background": "#0f172a",
    "text": "#f1f5f9",
    "light-bg": "#1e293b",
    "stripe": "#334155"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei",
    "title_cn": "Microsoft YaHei",
    "body_cn": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 40,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": true,
    "section_divider": true,
    "page_number": true,
    "header_enabled": true,
    "icon_set": "minimal"
  },
  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#111827",
      "#3b82f6",
      "#10b981",
      "#28385c"
    ],
    "progress_bar": true,
    "kpi_card_style": "glass"
  }
}