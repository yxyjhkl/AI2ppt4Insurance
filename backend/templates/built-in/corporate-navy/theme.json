{
  "name": "Corporate Navy",
  "category": "Insurance",
  "description": "Trustworthy navy blue for corporate proposals.",
  "colors": {
    "primary": "#1e3a5f",
    "secondary": "#2d6da8",
    "accent": "#d4a843",
    "background": "#ffffff",
