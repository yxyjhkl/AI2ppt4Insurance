{
  "name": "Medical Clean",
  "category": "Report",
  "description": "Clean teal-white for healthcare and medical presentations.",
  "colors": {
    "primary": "#0f766e",
    "secondary": "#14b8a6",
    "accent": "#f43f5e",
    "background": "#ffffff",
    "text": "#1f2937",
    "light-bg": "#f0fdfa",
    "stripe": "#ccfbf1"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 36,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": false,
    "section_divider": true,
    "page_number": true,
    "header_enabled": true,
    "icon_set": "business"
  },
  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#0f766e",
      "#14b8a6",
      "#f43f5e",
      "#17b9ad"
    ],
    "progress_bar": true,
    "kpi_card_style": "rounded"
