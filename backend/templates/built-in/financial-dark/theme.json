{
  "name": "Financial Dark",
  "category": "Insurance",
  "description": "Elegant dark gold for financial reports and investor decks.",
  "colors": {
    "primary": "#1a202c",
    "secondary": "#d69e2e",
    "accent": "#38a169",
    "background": "#171923",
    "text": "#e2e8f0",
    "light-bg": "#2d3748",
    "stripe": "#4a5568"
  },
  "fonts": {
    "title": "Georgia",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 18,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 40,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": true,
    "section_divider": true,
    "page_number": true,
    "header_enabled": true,
    "icon_set": "minimal"
  },
  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#1a202c",
      "#d69e2e",
      "#38a169",
      "#36425c"
    ],
    "progress_bar": true,
    "kpi_card_style": "glass"
  }
}