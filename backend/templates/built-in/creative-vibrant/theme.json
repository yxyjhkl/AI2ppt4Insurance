{
  "name": "Creative Vibrant",
  "category": "Creative",
  "description": "Bold multi-color palette for creative agencies and design.",
  "colors": {
    "primary": "#db2777",
    "secondary": "#f97316",
    "accent": "#06b6d4",
    "background": "#ffffff",
    "text": "#1f2937",
    "light-bg": "#fdf2f8",
    "stripe": "#fce7f3"
  },
  "fonts": {
    "title": "Arial",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 35,
    "margin-y": 30,
    "title-size": 34,
    "body-size": 20,
    "line-height": 1.4
  },
  "visual_rules": {
