  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#7c3aed",
      "#a78bfa",
      "#f472b6",
      "#aa80f3"
    ],
    "progress_bar": true,
    "kpi_card_style": "rounded"
