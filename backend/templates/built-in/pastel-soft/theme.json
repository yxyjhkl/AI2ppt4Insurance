{
  "name": "Pastel Soft",
  "category": "Education",
  "description": "Soft pastel colors gentle on eyes for long training sessions.",
  "colors": {
    "primary": "#7c3aed",
    "secondary": "#a78bfa",
    "accent": "#f472b6",
    "background": "#fdf4ff",
    "text": "#581c87",
    "light-bg": "#f5f3ff",
    "stripe": "#ede9fe"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 30,
    "body-size": 20,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 36,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": false,
    "section_divider": true,
