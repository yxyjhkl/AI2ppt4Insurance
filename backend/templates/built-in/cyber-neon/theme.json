{
  "name": "Cyber Neon",
  "category": "Tech",
  "description": "Cyberpunk neon on dark for tech-forward presentations.",
  "colors": {
    "primary": "#0d0221",
    "secondary": "#00f5ff",
    "accent": "#ff00aa",
    "background": "#0a0015",
    "text": "#e0e0ff",
    "light-bg": "#1a0030",
    "stripe": "#2a0040"
  },
  "fonts": {
    "title": "Arial",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 35,
    "margin-y": 30,
    "title-size": 36,
    "body-size": 20,
    "line-height": 1.4
  },
  "visual_rules": {
    "title_size": 40,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": true,
    "section_divider": true,
    "page_number": true,
    "header_enabled": true,
    "icon_set": "minimal"
  },
  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#0d0221",
      "#00f5ff",
      "#ff00aa",
      "#290669"
    ],
    "progress_bar": true,
    "kpi_card_style": "glass"
  }
}