  "animation": {
    "type": "none",
    "title_animation": "fade_in",
    "duration": 0.3
  },
  "elements": {
    "bullet_style": "disc",
    "table_stripe": true,
    "chart_colors": [
      "#7c3aed",
      "#f59e0b",
      "#ec4899",
      "#aa80f3"
    ],
    "progress_bar": true,
    "kpi_card_style": "rounded"
