{
  "name": "Gradient Sunset",
  "category": "Creative",
  "description": "Vibrant purple-to-orange gradient backgrounds.",
  "colors": {
    "primary": "#7c3aed",
    "secondary": "#f59e0b",
    "accent": "#ec4899",
    "background": "#fdf2f8",
    "text": "#1f2937",
    "light-bg": "#faf5ff",
    "stripe": "#f3e8ff"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei",
    "title_cn": "Microsoft YaHei",
    "body_cn": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "visual_rules": {
    "title_size": 36,
    "subtitle_size": 20,
    "body_size": 16,
    "caption_size": 12,
    "corner_radius": 4,
    "card_elevation": 2,
    "shadow_enabled": true,
    "gradient_bg": false,
    "section_divider": true,
