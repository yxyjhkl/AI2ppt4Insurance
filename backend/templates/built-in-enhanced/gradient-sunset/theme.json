{
  "name": "Gradient Sunset",
  "category": "Creative",
  "description": "Vibrant purple-to-orange gradient backgrounds.",
  "colors": {
    "primary": "#7c3aed",
    "secondary": "#f59e0b",
    "accent": "#ec4899",
    "background": "#fdf2f8",
    "text": "#1f2937",
    "light-bg": "#faf5ff",
    "stripe": "#f3e8ff"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei",
    "title_cn": "Microsoft YaHei",
    "body_cn": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#7c3aed 0%, #f59e0b 100%",
    "accent": "#ec4899 0%, #f17eb7 100%",
    "hero": "#7c3aed 0%, #ec4899 100%",
    "soft": "#d7c3f9 0%, #fce1b5 100%",
    "subtle": "#fdf2f8 0%, #f1ebfd 100%"
  },
  "color_variants": {
    "primary_light": "#9661f0",
    "primary_dark": "#632ebd",
    "secondary_light": "#f7b13b",
    "secondary_dark": "#c47e08",
    "accent_light": "#f17eb7",
    "accent_dark": "#bc397a",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#7c3aed 0%, #f59e0b 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#7c3aed",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#ec4899",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#ec4899",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#bbbec3",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#fdf2f8",
      "border_color": "#bd9cf6",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#f1ebfd",
      "border_color": "#7c3aed",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #7c3aed, #f59e0b)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(124, 58, 237, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#7c3aed",
    "secondary": "#f59e0b",
    "accent": "#ec4899",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#1f2937",
    "muted": "#8f949b"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f8f5fe"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#f1ebfd"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dddee1",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}