{
  "name": "Clean White",
  "category": "Education",
  "description": "Minimalist white design with subtle gray accents.",
  "colors": {
    "primary": "#1f2937",
    "secondary": "#6b7280",
    "accent": "#2563eb",
    "background": "#ffffff",
    "text": "#111827",
    "light-bg": "#f9fafb",
    "stripe": "#f3f4f6"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei",
    "title_cn": "Microsoft YaHei",
    "body_cn": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#1f2937 0%, #6b7280 100%",
    "accent": "#2563eb 0%, #6691f1 100%",
    "hero": "#1f2937 0%, #2563eb 100%",
    "soft": "#bbbec3 0%, #d2d4d8 100%",
    "subtle": "#ffffff 0%, #e8e9eb 100%"
  },
  "color_variants": {
    "primary_light": "#4b535f",
    "primary_dark": "#18202c",
    "secondary_light": "#888e99",
    "secondary_dark": "#555b66",
    "accent_light": "#6691f1",
    "accent_dark": "#1d4fbc",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#1f2937 0%, #6b7280 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#1f2937",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#2563eb",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#2563eb",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#b7b9be",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#ffffff",
      "border_color": "#8f949b",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e8e9eb",
      "border_color": "#1f2937",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #1f2937, #6b7280)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(31, 41, 55, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#1f2937",
    "secondary": "#6b7280",
    "accent": "#2563eb",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#111827",
    "muted": "#888b93"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f3f4f5"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e8e9eb"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dbdcde",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}