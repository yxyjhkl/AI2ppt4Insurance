{
  "name": "Financial Dark",
  "category": "Report",
  "description": "Elegant dark gold for financial reports and investor decks.",
  "colors": {
    "primary": "#1a202c",
    "secondary": "#d69e2e",
    "accent": "#38a169",
    "background": "#171923",
    "text": "#e2e8f0",
    "light-bg": "#2d3748",
    "stripe": "#4a5568"
  },
  "fonts": {
    "title": "Georgia",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 18,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#1a202c 0%, #d69e2e 100%",
    "accent": "#38a169 0%, #73bd96 100%",
    "hero": "#1a202c 0%, #38a169 100%",
    "soft": "#babcbf 0%, #f2e1c0 100%",
    "subtle": "#171923 0%, #e8e8e9 100%"
  },
  "color_variants": {
    "primary_light": "#474c56",
    "primary_dark": "#141923",
    "secondary_light": "#deb157",
    "secondary_dark": "#ab7e24",
    "accent_light": "#73bd96",
    "accent_dark": "#2c8054",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#1a202c 0%, #d69e2e 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#1a202c",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#38a169",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#38a169",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#f6f8fa",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#171923",
      "border_color": "#8c8f95",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e8e8e9",
      "border_color": "#1a202c",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #1a202c, #d69e2e)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(26, 32, 44, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#1a202c",
    "secondary": "#d69e2e",
    "accent": "#38a169",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#e2e8f0",
    "muted": "#f0f3f7"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f3f3f4"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e8e8e9"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#fafbfc",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}