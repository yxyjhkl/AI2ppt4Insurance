{
  "name": "Corporate Navy",
  "category": "Proposal",
  "description": "Trustworthy navy blue for corporate proposals.",
  "colors": {
    "primary": "#1e3a5f",
    "secondary": "#2d6da8",
    "accent": "#d4a843",
    "background": "#ffffff",
    "text": "#1a202c",
    "light-bg": "#f0f4f8",
    "stripe": "#e2e8f0"
  },
  "fonts": {
    "title": "Georgia",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#1e3a5f 0%, #2d6da8 100%",
    "accent": "#d4a843 0%, #e0c27b 100%",
    "hero": "#1e3a5f 0%, #d4a843 100%",
    "soft": "#bbc3cf 0%, #c0d3e4 100%",
    "subtle": "#ffffff 0%, #e8ebef 100%"
  },
  "color_variants": {
    "primary_light": "#4b617f",
    "primary_dark": "#182e4c",
    "secondary_light": "#578ab9",
    "secondary_dark": "#245786",
    "accent_light": "#e0c27b",
    "accent_dark": "#a98635",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#1e3a5f 0%, #2d6da8 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#1e3a5f",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#d4a843",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#d4a843",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#babcbf",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#ffffff",
      "border_color": "#8e9caf",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e8ebef",
      "border_color": "#1e3a5f",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #1e3a5f, #2d6da8)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(30, 58, 95, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#1e3a5f",
    "secondary": "#2d6da8",
    "accent": "#d4a843",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#1a202c",
    "muted": "#8c8f95"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f3f5f7"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e8ebef"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dcdddf",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}