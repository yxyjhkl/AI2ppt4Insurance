{
  "name": "Pastel Soft",
  "category": "Education",
  "description": "Soft pastel colors gentle on eyes for long training sessions.",
  "colors": {
    "primary": "#7c3aed",
    "secondary": "#a78bfa",
    "accent": "#f472b6",
    "background": "#fdf4ff",
    "text": "#581c87",
    "light-bg": "#f5f3ff",
    "stripe": "#ede9fe"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 30,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#7c3aed 0%, #a78bfa 100%",
    "accent": "#f472b6 0%, #f79ccb 100%",
    "hero": "#7c3aed 0%, #f472b6 100%",
    "soft": "#d7c3f9 0%, #e4dcfd 100%",
    "subtle": "#fdf4ff 0%, #f1ebfd 100%"
  },
  "color_variants": {
    "primary_light": "#9661f0",
    "primary_dark": "#632ebd",
    "secondary_light": "#b8a2fb",
    "secondary_dark": "#856fc8",
    "accent_light": "#f79ccb",
    "accent_dark": "#c35b91",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#7c3aed 0%, #a78bfa 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#7c3aed",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#f472b6",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#f472b6",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#ccbadb",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#fdf4ff",
      "border_color": "#bd9cf6",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#f1ebfd",
      "border_color": "#7c3aed",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #7c3aed, #a78bfa)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(124, 58, 237, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#7c3aed",
    "secondary": "#a78bfa",
    "accent": "#f472b6",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#581c87",
    "muted": "#ab8dc3"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f8f5fe"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#f1ebfd"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#e5dced",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}