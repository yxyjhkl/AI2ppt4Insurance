{
  "name": "Pitch Dark",
  "category": "Proposal",
  "description": "Bold dark theme with accent highlights for investor pitches.",
  "colors": {
    "primary": "#0f172a",
    "secondary": "#38bdf8",
    "accent": "#a855f7",
    "background": "#020617",
    "text": "#f8fafc",
    "light-bg": "#1e293b",
    "stripe": "#334155"
  },
  "fonts": {
    "title": "Arial",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 36,
    "body-size": 22,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#0f172a 0%, #38bdf8 100%",
    "accent": "#a855f7 0%, #c288f9 100%",
    "hero": "#0f172a 0%, #a855f7 100%",
    "soft": "#b7b9bf 0%, #c3ebfc 100%",
    "subtle": "#020617 0%, #e7e7e9 100%"
  },
  "color_variants": {
    "primary_light": "#3f4554",
    "primary_dark": "#0c1221",
    "secondary_light": "#5fcaf9",
    "secondary_dark": "#2c97c6",
    "accent_light": "#c288f9",
    "accent_dark": "#8644c5",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#0f172a 0%, #38bdf8 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#0f172a",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#a855f7",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#a855f7",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#fcfdfe",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#020617",
      "border_color": "#878b94",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e7e7e9",
      "border_color": "#0f172a",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #0f172a, #38bdf8)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(15, 23, 42, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#0f172a",
    "secondary": "#38bdf8",
    "accent": "#a855f7",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#f8fafc",
    "muted": "#fbfcfd"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f3f3f4"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e7e7e9"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#fdfefe",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}