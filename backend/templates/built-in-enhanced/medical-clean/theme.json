{
  "name": "Medical Clean",
  "category": "Report",
  "description": "Clean teal-white for healthcare and medical presentations.",
  "colors": {
    "primary": "#0f766e",
    "secondary": "#14b8a6",
    "accent": "#f43f5e",
    "background": "#ffffff",
    "text": "#1f2937",
    "light-bg": "#f0fdfa",
    "stripe": "#ccfbf1"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#0f766e 0%, #14b8a6 100%",
    "accent": "#f43f5e 0%, #f7788e 100%",
    "hero": "#0f766e 0%, #f43f5e 100%",
    "soft": "#b7d5d3 0%, #b8e9e4 100%",
    "subtle": "#ffffff 0%, #e7f1f0 100%"
  },
  "color_variants": {
    "primary_light": "#3f918b",
    "primary_dark": "#0c5e58",
    "secondary_light": "#43c6b7",
    "secondary_dark": "#109384",
    "accent_light": "#f7788e",
    "accent_dark": "#c3324b",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#0f766e 0%, #14b8a6 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#0f766e",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#f43f5e",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#f43f5e",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#bbbec3",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#ffffff",
      "border_color": "#87bab6",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e7f1f0",
      "border_color": "#0f766e",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #0f766e, #14b8a6)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(15, 118, 110, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#0f766e",
    "secondary": "#14b8a6",
    "accent": "#f43f5e",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#1f2937",
    "muted": "#8f949b"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f3f8f7"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e7f1f0"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dddee1",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}