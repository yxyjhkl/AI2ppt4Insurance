{
  "name": "Academic Defense",
  "category": "Education",
  "description": "Formal blue for thesis defense and academic presentations.",
  "colors": {
    "primary": "#003366",
    "secondary": "#336699",
    "accent": "#cc0000",
    "background": "#ffffff",
    "text": "#1a1a1a",
    "light-bg": "#f0f5fa",
    "stripe": "#e6eef5"
  },
  "fonts": {
    "title": "Times New Roman",
    "body": "Arial"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#003366 0%, #336699 100%",
    "accent": "#cc0000 0%, #db4c4c 100%",
    "hero": "#003366 0%, #cc0000 100%",
    "soft": "#b2c1d1 0%, #c1d1e0 100%",
    "subtle": "#ffffff 0%, #e5eaef 100%"
  },
  "color_variants": {
    "primary_light": "#335b84",
    "primary_dark": "#002851",
    "secondary_light": "#5b84ad",
    "secondary_dark": "#28517a",
    "accent_light": "#db4c4c",
    "accent_dark": "#a30000",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#003366 0%, #336699 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#003366",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#cc0000",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#cc0000",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#bababa",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#ffffff",
      "border_color": "#7f99b2",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#e5eaef",
      "border_color": "#003366",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #003366, #336699)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(0, 51, 102, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#003366",
    "secondary": "#336699",
    "accent": "#cc0000",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#1a1a1a",
    "muted": "#8c8c8c"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f2f4f7"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#e5eaef"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dcdcdc",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}