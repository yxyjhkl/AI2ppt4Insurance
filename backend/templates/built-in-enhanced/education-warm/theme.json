{
  "name": "Education Warm",
  "category": "Education",
  "description": "Warm orange-brown tones friendly for classroom settings.",
  "colors": {
    "primary": "#92400e",
    "secondary": "#d97706",
    "accent": "#059669",
    "background": "#fffbeb",
    "text": "#1f2937",
    "light-bg": "#fef3c7",
    "stripe": "#fde68a"
  },
  "fonts": {
    "title": "Arial",
    "body": "Microsoft YaHei"
  },
  "spacing": {
    "margin-x": 40,
    "margin-y": 30,
    "title-size": 32,
    "body-size": 20,
    "line-height": 1.5
  },
  "gradients": {
    "primary": "#92400e 0%, #d97706 100%",
    "accent": "#059669 0%, #50b596 100%",
    "hero": "#92400e 0%, #059669 100%",
    "soft": "#dec5b6 0%, #f3d6b4 100%",
    "subtle": "#fffbeb 0%, #f4ebe6 100%"
  },
  "color_variants": {
    "primary_light": "#a7663e",
    "primary_dark": "#74330b",
    "secondary_light": "#e09237",
    "secondary_dark": "#ad5f04",
    "accent_light": "#50b596",
    "accent_dark": "#047854",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6"
  },
  "decorations": {
    "header_bar": {
      "height": 8,
      "gradient": "#92400e 0%, #d97706 100%",
      "rounded": true
    },
    "footer_bar": {
      "height": 4,
      "color": "#92400e",
      "style": "solid"
    },
    "side_border": {
      "width": 3,
      "color": "#059669",
      "position": "left"
    },
    "corner_ribbon": {
      "enabled": false,
      "color": "#059669",
      "position": "top-right"
    },
    "divider_line": {
      "height": 1,
      "color": "#bbbec3",
      "style": "dashed"
    }
  },
  "card_styles": {
    "default": {
      "background": "#fffbeb",
      "border_color": "#c89f86",
      "border_width": 1,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 2,
        "blur": 8,
        "color": "rgba(0,0,0,0.1)"
      },
      "padding": {
        "top": 20,
        "right": 24,
        "bottom": 20,
        "left": 24
      }
    },
    "accent": {
      "background": "#f4ebe6",
      "border_color": "#92400e",
      "border_width": 2,
      "corner_radius": 8,
      "shadow": {
        "enabled": true,
        "depth": 3,
        "blur": 12,
        "color": "rgba(0,0,0,0.15)"
      },
      "padding": {
        "top": 24,
        "right": 28,
        "bottom": 24,
        "left": 28
      }
    },
    "kpi": {
      "background": "linear-gradient(135deg, #92400e, #d97706)",
      "border_color": "transparent",
      "border_width": 0,
      "corner_radius": 12,
      "shadow": {
        "enabled": true,
        "depth": 4,
        "blur": 16,
        "color": "rgba(146, 64, 14, 0.3)"
      },
      "padding": {
        "top": 28,
        "right": 32,
        "bottom": 28,
        "left": 32
      }
    }
  },
  "icon_colors": {
    "primary": "#92400e",
    "secondary": "#d97706",
    "accent": "#059669",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444",
    "info": "#3b82f6",
    "text": "#1f2937",
    "muted": "#8f949b"
  },
  "background_patterns": {
    "gradient_diagonal": {
      "type": "linear",
      "angle": 135,
      "colors": [
        {
          "stop": 0,
          "color": "#ffffff"
        },
        {
          "stop": 100,
          "color": "#f9f5f2"
        }
      ]
    },
    "gradient_radial": {
      "type": "radial",
      "center": "50% 50%",
      "radius": "50%",
      "colors": [
        {
          "stop": 0,
          "color": "#f4ebe6"
        },
        {
          "stop": 100,
          "color": "#ffffff"
        }
      ]
    },
    "subtle_grid": {
      "type": "grid",
      "size": 40,
      "color": "#dddee1",
      "line_width": 1
    },
    "none": {
      "type": "solid",
      "color": "#ffffff"
    }
  }
}